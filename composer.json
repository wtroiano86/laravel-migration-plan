{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wtroiano/laravel-migration-plan",
    "description": "Dependency-aware migration ownership, ordering, and rollback for Laravel",
    "type": "library",
    "homepage": "https://github.com/wtroiano86/laravel-migration-plan",
    "license": "MIT",
    "authors": [
        {
            "name": "William Troiano",
            "homepage": "https://github.com/wtroiano86"
        }
    ],
    "support": {
        "issues": "https://github.com/wtroiano86/laravel-migration-plan/issues",
        "source": "https://github.com/wtroiano86/laravel-migration-plan",
        "docs": "https://github.com/wtroiano86/laravel-migration-plan/blob/HEAD/docs/README.md",
        "security": "https://github.com/wtroiano86/laravel-migration-plan/security/policy"
    },
    "require": {
        "php": "^8.5.0",
        "illuminate/console": "^13.34",
        "illuminate/contracts": "^13.34",
        "illuminate/database": "^13.34",
        "illuminate/events": "^13.34",
        "illuminate/filesystem": "^13.34",
        "illuminate/pipeline": "^13.34",
        "illuminate/support": "^13.34",
        "symfony/console": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Wtroiano\\MigrationPlan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wtroiano\\MigrationPlan\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "larastan/larastan": "^3.12.2",
        "laravel/framework": "^13.34.0",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.2",
        "phpstan/phpstan": "^2.2.16",
        "rector/rector": "^2.6.7"
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@test:lint @no_additional_args",
            "@test:types @no_additional_args",
            "@test:type-coverage @no_additional_args",
            "@test:coverage"
        ],
        "lint": [
            "@php vendor/bin/rector process",
            "@php vendor/bin/pint"
        ],
        "test:lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/rector process --dry-run"
        ],
        "test:types": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "test:all": "@test",
        "test:coverage": "@test:unit --coverage --exactly=100.0",
        "test:type-coverage": "@test:unit --type-coverage --min=100",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test:unit": "@php vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "keywords": [
        "laravel",
        "migrations",
        "dependencies"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Wtroiano\\MigrationPlan\\Providers\\PackageServiceProvider"
            ]
        }
    }
}
